{
  "manifest_version": 3,
  "name": "ChatOverlay Cookie Export",
  "version": "1.1",
  "description": "Exports your YouTube login cookies as cookies.txt for YouTube Live Chat Overlay. Links directly to the app so its \"Get cookies\" button works without closing the browser.",
  "key": "",
  "permissions": ["cookies", "downloads", "nativeMessaging", "alarms"],
  "host_permissions": ["*://*.youtube.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Export cookies.txt (ChatOverlay)"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
