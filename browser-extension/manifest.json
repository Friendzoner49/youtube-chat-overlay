{
  "manifest_version": 3,
  "name": "ChatOverlay Cookie Export",
  "version": "1.0",
  "description": "Exports your YouTube/Google login cookies as cookies.txt for YouTube Live Chat Overlay, without closing the browser.",
  "permissions": ["cookies", "downloads"],
  "host_permissions": ["*://*.youtube.com/*", "*://*.google.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Export cookies.txt (ChatOverlay)"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
